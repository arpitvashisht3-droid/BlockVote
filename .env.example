# ============================================================
# BlockVote Frontend — Environment Configuration Template
# Copy this file to .env for local configuration.
# .env is git-ignored and MUST NEVER be committed.
#
# Only VITE_ prefixed variables are exposed to the browser.
# NEVER add private keys or service-role credentials here.
# ============================================================

# ----------------------------------------------------------
# Contract Address (Public — safe to expose to browser)
# Sepolia Testnet Contract Address:
# ----------------------------------------------------------
VITE_CONTRACT_ADDRESS=your-sepolia-contract-address-here
