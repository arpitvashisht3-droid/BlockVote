# ============================================================
# BlockVote Backend — Environment Configuration Template
# Copy this file to backend/.env for local development.
# backend/.env is git-ignored and MUST NEVER be committed.
# ============================================================

# Application Port
PORT=3000

# ----------------------------------------------------------
# Supabase Database (server-side only, never expose to frontend)
# ----------------------------------------------------------
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ----------------------------------------------------------
# Blockchain Network Configuration
#
# LOCAL DEVELOPMENT (Hardhat):
#   BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
#   BLOCKCHAIN_CONTRACT_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
#   BLOCKCHAIN_PRIVATE_KEY=<hardhat-account-0-private-key>
#
# SEPOLIA TESTNET:
#   BLOCKCHAIN_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
#   BLOCKCHAIN_CONTRACT_ADDRESS=<sepolia-deployed-contract-address>
#   BLOCKCHAIN_PRIVATE_KEY=<your-sepolia-deployer-private-key>
#
# SECURITY: BLOCKCHAIN_PRIVATE_KEY must ONLY appear in backend/.env.
#           Never use a VITE_ prefix for private keys.
#           Never commit backend/.env.
# ----------------------------------------------------------
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
BLOCKCHAIN_CONTRACT_ADDRESS=0xe7f1725e7734ce288f8367e1bb143e90bb3f0512
BLOCKCHAIN_PRIVATE_KEY=
